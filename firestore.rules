rules_version = '2';
// Clients never read or write Firestore directly. Every collection is reached through Cloud Functions (Admin SDK),
// which enforce role, hospital scope, care relationship and the append-only record rules. Anything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
