{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "default", "ignore": ["node_modules"] }],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/sendInvite",
        "function": { "functionId": "sendInvite", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportUpload",
        "function": { "functionId": "uploadSecureReport", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportStatus",
        "function": { "functionId": "getSecureReportStatus", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportRetry",
        "function": { "functionId": "retrySecureReport", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportPage",
        "function": { "functionId": "getSecureReportPage", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportSummary",
        "function": { "functionId": "getSecureReportSummary", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportIdentity",
        "function": { "functionId": "getSecureReportIdentity", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportSummarize",
        "function": { "functionId": "requestSecureReportSummary", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportAiStatus",
        "function": { "functionId": "getSecureReportAiStatus", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportAiConsent",
        "function": { "functionId": "getSecureReportAiConsent", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportAiConsentUpdate",
        "function": { "functionId": "setSecureReportAiConsent", "region": "asia-south1" }
      },
      {
        "source": "/api/secureReportReview",
        "function": { "functionId": "reviewSecureReportSummary", "region": "asia-south1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; img-src 'self' data:; connect-src 'self' https://asia-south1-care-vault-project.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com; object-src 'self' blob:; frame-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
